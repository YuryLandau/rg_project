# URL pública da API no Cloud Run. Não inclua barra no final.
VITE_API_BASE_URL=https://sua-api.run.app
VITE_APP_ENV=production

# Recursos fechados por padrão. Habilite somente depois de concluir os requisitos
# jurídicos e configurar os serviços correspondentes na API.
VITE_AUTHENTICATION_ENABLED=false
VITE_SUBSCRIPTIONS_ENABLED=false
VITE_DOWNLOADS_ENABLED=false

VITE_AUTHENTICATION_DISABLED_MESSAGE=O cadastro e o acesso à conta serão disponibilizados em breve. Estamos finalizando os Termos de Uso e a Política de Privacidade para lançar essa área com segurança e transparência.
VITE_SUBSCRIPTIONS_DISABLED_MESSAGE=Os planos e assinaturas da RG BIM estão em preparação. Em breve você poderá criar sua conta e escolher o plano ideal.
VITE_DOWNLOADS_DISABLED_MESSAGE=Estamos finalizando os instaladores e a biblioteca de recursos da RG BIM. Os downloads estarão disponíveis em breve.
